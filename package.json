{
  "name": "@webship-js/nextjs-steps",
  "version": "2.0.1",
  "description": "Cucumber step definitions for apps built with Next.js, a plugin for webship-js (Playwright and Cucumber): hydration, client-side navigation and the route announcer, prefetching, streaming and loading states, form actions and their pending states, the not-found and error pages, the image component's lazy and optimized images, static and dynamic pages, the production build and the development error overlay, and a login form with sessions, each step waiting on the framework's own signals, never on a clock.",
  "main": "tests/step-definitions/nextjs-helpers.js",
  "files": [
    "tests/step-definitions/",
    "tests/features/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "cucumber-js --config cucumber.js",
    "test:dry": "cucumber-js --config cucumber.js --dry-run",
    "test:examples": "node tests/check-examples.js",
    "test:paths": "node tests/check-paths.js",
    "test:must-fail": "node tests/check-must-fail.js",
    "test:chromium": "BROWSER=chromium cucumber-js --config cucumber.js",
    "test:firefox": "BROWSER=firefox cucumber-js --config cucumber.js",
    "test:webkit": "BROWSER=webkit cucumber-js --config cucumber.js",
    "test:headed": "HEADLESS=false cucumber-js --config cucumber.js",
    "generate-reports": "generate-reports",
    "test:fast": "SLOW_MO=0 cucumber-js --config cucumber.js"
  },
  "keywords": [
    "webship-js",
    "nextjs",
    "next.js",
    "react",
    "hydration",
    "server-actions",
    "cucumber",
    "cucumber-js",
    "playwright",
    "bdd",
    "testing",
    "e2e",
    "gherkin"
  ],
  "author": "Webship.co",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webship/nextjs-steps.git"
  },
  "bugs": {
    "url": "https://github.com/webship/nextjs-steps/issues"
  },
  "homepage": "https://github.com/webship/nextjs-steps#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">= 24.0"
  },
  "peerDependencies": {
    "webship-js": "^2.0.16"
  },
  "devDependencies": {
    "tsx": "^4.23.0",
    "webship-js": "^2.0.16"
  },
  "overrides": {
    "@cucumber/cucumber": "^12"
  }
}
